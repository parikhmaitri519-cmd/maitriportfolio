        flex-direction: row;
        align-items: center;
        gap: 5px;

        background: transparent;

        border: 0;
        border-radius: 0;

        box-shadow: none;

        opacity: 1;
        visibility: visible;
        transform: none;
    }

    .nav-links a {
        padding: 9px 13px;
    }

    .nav-links a:hover,
    .nav-links a:focus {
        color: var(--accent);

